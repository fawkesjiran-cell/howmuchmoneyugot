{
  "name": "how-much-money-u-got",
  "version": "1.5.2",
  "description": "A compact cross-platform earnings ticker for macOS and Windows.",
  "main": "src/main.cjs",
  "author": "fawkesjiran-cell",
  "license": "MIT",
  "private": true,
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "pack:mac": "electron-builder --mac --publish never",
    "pack:mac:release": "electron-builder --mac zip --universal --publish never",
    "pack:win": "electron-builder --win --publish never",
    "dist": "electron-builder --mac --win --publish never"
  },
  "devDependencies": {
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0"
  }
}
